export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="ibra"
ZSH_DISABLE_COMPFIX="true"
ENABLE_CORRECTION="true"
plugins=(git cp colorize battery grc)
source $ZSH/oh-my-zsh.sh

source /Users/YG/.dot-files/customs/alias

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PATH="$PATH:$HOME/.flutter-sdk/bin"

export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"

# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
export PATH="$PATH:$HOME/.rvm/bin"

export PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"
export PATH="$PATH:/opt/homebrew/bin/python3"


export ANDROID_HOME="~/Library/Android/sdk"

export M2_HOME="/Users/YG/.mvn/apache-maven-3.6.3"

# bun completions
[ -s "/Users/YG/.bun/_bun" ] && source "/Users/YG/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools:$M2_HOME/bin"

export CI_SERVER_URL=https://gitlab.com
export AILAB_GROUP_ID=3707208
export AILAB_PROFILE=local
export AILAB_BUREN_GROUP_ID=54123414
export AILAB_BUREN_GROUP_ID_NEW=44070181

export PATH="$HOME/.jenv/bin:$PATH"
eval "$(jenv init -)"
export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"

PATH=~/.console-ninja/.bin:$PATH
